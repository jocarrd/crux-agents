#!/usr/bin/env bash
# crux — kernel of the agent work system.
#
# The commands are one binary. This finds the one that belongs to this kernel
# —installed next to it as bin/crux-core, or built from rs/— and runs it, so a
# clone of the repo works right after `cargo build`. `crux help` lists the
# commands.
here="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
export CRUX_HOME="$here"
# From a clone, the most recent build: `cargo build` writes debug, and running
# an older release beside it tests code that is no longer the source.
built="$here/rs/target/release/crux"
[[ "$here/rs/target/debug/crux" -nt "$built" ]] && built="$here/rs/target/debug/crux"
for c in "${CRUX_BIN:-}" "$here/bin/crux-core" "$built"; do
  [[ -n "$c" && -x "$c" ]] && exec "$c" "$@"
done
echo "crux: the binary is missing — build it with: cargo build --release --manifest-path $here/rs/Cargo.toml" >&2
exit 127
