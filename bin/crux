#!/usr/bin/env bash
# crux — kernel del sistema de trabajo con agentes.
# Despachador de subcomandos. Ver STANDARD.md para el estándar completo.

set -euo pipefail

SELF="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
export CRUX_HOME="$(dirname "$SELF")"

# shellcheck source=lib/common.sh
source "$CRUX_HOME/lib/common.sh"

usage() {
  cat <<'EOF'
crux — kernel del sistema de trabajo con agentes

  crux init <project>   crea el docs repo de un proyecto nuevo
  crux adopt [dir]      registra un docs repo que ya existe
  crux add-repo <repo>  registra un repo nuevo en el proyecto
  crux link [dir]       genera y verifica los punteros de los repos de código
  crux workspace ...    espacios aislados para trabajar en paralelo
  crux hooks ...        engancha el estándar al cierre de sesión y al commit
  crux usage            qué skills se usan de verdad
  crux doctor [dir]     verifica la conformidad con el estándar
  crux doctor --machine verifica que esta máquina puede con todo
  crux upgrade [dir]    re-materializa el kernel a la versión actual
  crux version          versión del kernel y su ruta

Sin argumento de directorio, los comandos operan sobre el docs repo que
encuentran subiendo desde el directorio actual.
EOF
}

cmd="${1:-help}"
[[ $# -gt 0 ]] && shift || true

case "$cmd" in
  init)    exec bash "$CRUX_HOME/bin/init.sh" "$@" ;;
  adopt)   exec bash "$CRUX_HOME/bin/adopt.sh" "$@" ;;
  add-repo) exec bash "$CRUX_HOME/bin/add-repo.sh" "$@" ;;
  link)    exec bash "$CRUX_HOME/bin/link.sh" "$@" ;;
  workspace) exec bash "$CRUX_HOME/bin/workspace.sh" "$@" ;;
  hooks)   exec bash "$CRUX_HOME/bin/hooks.sh" "$@" ;;
  usage)   exec node "$CRUX_HOME/bin/usage.mjs" "$@" ;;
  doctor)  exec bash "$CRUX_HOME/bin/doctor.sh" "$@" ;;
  upgrade) exec bash "$CRUX_HOME/bin/upgrade.sh" "$@" ;;
  version) echo "crux $(crux_version) — $CRUX_HOME" ;;
  help|-h|--help) usage ;;
  *) err "subcomando desconocido: $cmd"; echo; usage; exit 1 ;;
esac
